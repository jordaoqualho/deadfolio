# Local filesystem is the default outside Vercel. Vercel requires blob mode.
PROJECT_REPOSITORY=local
LOCAL_DATA_DIR=.data
SEED_DEMOS=true
# Use a PRIVATE Vercel Blob store. On Vercel, BLOB_STORE_ID (OIDC) is enough.
# BLOB_READ_WRITE_TOKEN is only required outside Vercel, e.g. npm run seed.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Set a long, random password (at least 16 characters) to enable /admin.
ADMIN_PASSWORD=
PORT=3535
NEXT_PUBLIC_APP_URL=http://localhost:3535
# Optional: setting this key enables Gemini formatting and Repository Autopsy. Without it, stories submit directly.
GEMINI_API_KEY=
# Repository Autopsy: server-only GitHub token (fine-grained, public repositories, read-only).
# Unauthenticated GitHub allows only 60 requests/hour per IP; set a token before production.
GITHUB_TOKEN=
# Hard application limits for Repository Autopsy. Defaults shown.
MAX_REPOSITORIES_PER_SCAN=100
MAX_AUTOPSIES_PER_IP_PER_DAY=3
MAX_CONCURRENT_AUTOPSIES_PER_IP=1
MAX_AUTOPSY_FILES=12
MAX_AUTOPSY_INPUT_TOKENS=30000
MAX_AUTOPSY_OUTPUT_TOKENS=2000
# Enable only after opting into Vercel Web Analytics in your project.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
