# Local filesystem is the default outside Vercel. Vercel requires blob mode.
PROJECT_REPOSITORY=local
LOCAL_DATA_DIR=.data
SEED_DEMOS=true
# Use a PRIVATE Vercel Blob store. On Vercel, BLOB_STORE_ID (OIDC) is enough.
# BLOB_READ_WRITE_TOKEN is only required outside Vercel, e.g. npm run seed.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
PORT=3535
NEXT_PUBLIC_APP_URL=http://localhost:3535
# Gemini (gemini-2.5-flash) powers Repository Autopsy. Server-side only, never sent to the browser.
# Without it, scanning and Dead Scores still work; running an autopsy shows a configuration error.
GEMINI_API_KEY=
# Optional: override the Gemini model id. Default gemini-2.5-flash. Google retires ids for new keys;
# if autopsies fail with a 404 in the server log, set the id Google recommends (e.g. gemini-3.6-flash).
GEMINI_MODEL=
# Server-only GitHub token (fine-grained, public repositories, read-only). Never exposed to the client.
# Unauthenticated GitHub allows only 60 requests/hour per IP; set a token before production.
GITHUB_TOKEN=
# Hard application limits for Repository Autopsy. Defaults shown.
MAX_REPOSITORIES_PER_SCAN=100
MAX_AUTOPSIES_PER_IP_PER_DAY=3
MAX_CONCURRENT_AUTOPSIES_PER_IP=1
MAX_AUTOPSY_FILES=12
MAX_AUTOPSY_INPUT_TOKENS=30000
MAX_AUTOPSY_OUTPUT_TOKENS=2000
# Optional: salt for the hashed per-IP daily autopsy quota keys.
AUTOPSY_QUOTA_SALT=
# Enable only after opting into Vercel Web Analytics in your project.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
