# Local filesystem is the default outside Vercel. Vercel requires blob mode.
PROJECT_REPOSITORY=local
LOCAL_DATA_DIR=.data
SEED_DEMOS=true
# Use a PRIVATE Vercel Blob store. No credentials are needed locally.
BLOB_READ_WRITE_TOKEN=
# Set a long, random password (at least 16 characters) to enable /admin.
ADMIN_PASSWORD=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Both values are required to explicitly opt into AI provider usage.
AI_ENABLED=false
GEMINI_API_KEY=
# Enable only after opting into Vercel Web Analytics in your project.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
